# 枢纽应用凭据（飞书开发者后台 → 凭证与基础信息）。复制为 hub.env，权限 600，
# 不要提交进仓库（.gitignore 已排除 hub.env）。
APP_ID=
APP_SECRET=

# 其余配置不在本文件里，走进程环境变量（见 hub_api.py 文件头）：
#   HUB_BASE_TOKEN / HUB_TASKS_TABLE / HUB_RUNS_TABLE / HUB_MESSAGES_TABLE /
#   HUB_PARTS_TABLE / HUB_AGENTCARDS_TABLE / HUB_OWNER_OPEN_ID
# 出站需要代理时再加：
#   HTTPS_PROXY=
